    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node test/sync.mjs"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.152.0"
  }
}
