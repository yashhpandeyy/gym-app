<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Ring on the exact minute (the person allows it once in the phone's settings on Android 12 and later). -->
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
  <!-- Show the alarm over the lock screen, like the phone's own clock. -->
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
  <!-- Keep ringing until it's stopped. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.VIBRATE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Alarms survive a restart of the phone. -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <application>
    <receiver android:name="expo.modules.gymalarm.AlarmReceiver" android:exported="false" />
    <receiver android:name="expo.modules.gymalarm.BootReceiver" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        <action android:name="android.intent.action.TIME_SET" />
        <action android:name="android.intent.action.TIMEZONE_CHANGED" />
      </intent-filter>
    </receiver>
    <service
      android:name="expo.modules.gymalarm.AlarmService"
      android:exported="false"
      android:foregroundServiceType="mediaPlayback" />
    <activity
      android:name="expo.modules.gymalarm.AlarmActivity"
      android:exported="false"
      android:excludeFromRecents="true"
      android:launchMode="singleInstance"
      android:taskAffinity=""
      android:theme="@android:style/Theme.Material.NoActionBar" />
  </application>
</manifest>
